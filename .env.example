# API Keys Configuration

# Gemini (FREE: 1000 requests/day)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MiniMax (Paid)
# Get key: https://www.minimax.io
MINIMAX_API_KEY=your_minimax_api_key_here

# Kimi/Moonshot (Paid)
# Get key: https://platform.moonshot.cn
KIMI_API_KEY=your_kimi_api_key_here

# xAI/Grok (Paid)
# Get key: https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# Brave Search (FREE: 2,000 queries/month)
# Get key: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# Optional: Custom API hosts
# MINIMAX_API_HOST=https://api.minimax.io
# KIMI_API_HOST=https://api.moonshot.cn
# XAI_API_HOST=https://api.x.ai

# Optional: Logging
# RUST_LOG=info
# DEBUG_MODE=false
